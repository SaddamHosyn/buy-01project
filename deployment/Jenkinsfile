// =============================================================================
// Buy-01 E-Commerce Platform - SafeZone + Deployment CI/CD Pipeline
// =============================================================================
pipeline {
    agent any

    parameters {
        choice(name: 'DEPLOY_ENV', choices: ['local', 'staging', 'production'], description: 'Select deployment environment')
        booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: 'Skip tests (use with caution)')
    }

    environment {
        DOCKER_USER          = credentials('docker-hub-username')
        REGISTRY_CREDENTIALS = 'docker-hub-credentials'
        // Tag images with build number for easy rollback
        IMAGE_TAG            = "${env.BUILD_NUMBER}"
        // Calculate previous tag for rollback (Simple strategy: BuildNum - 1)
        PREV_IMAGE_TAG       = "${env.BUILD_NUMBER.toInteger() - 1}"
    }

    triggers {
        githubPush()
    }

    stages {
        // Stage 1: Checkout
        stage('Checkout') {
            steps {
                echo "📦 Checking out code..."
                checkout scm
            }
        }

        // Stage 2: Secret Scanning
        stage('Secret Scanning') {
            steps {
                echo '🔍 Scanning for secrets...'
                script {
                    def result = sh(script: "grep -r -E -i 'api.?key.*=.*[A-Za-z0-9]{30,}' --include='*.java' --exclude-dir=target . || true", returnStdout: true).trim()
                    if (result) {
                        error('❌ Secrets detected! Pipeline blocked.')
                    }
                }
            }
        }

        // =====================================================================
        // SafeZone: SonarQube Analysis
        // =====================================================================
        stage('SonarQube Analysis') {
            steps {
                echo '📊 Running SonarQube Analysis...'
                withSonarQubeEnv('sonar-server') { 
                    sh """
                        mvn clean verify sonar:sonar \\
                        -Dsonar.projectKey=safezone-backend \\
                        -Dsonar.host.url=http://sonarqube:9000 \\
                        -Dmaven.test.failure.ignore=true
                    """
                }
            }
        }

        // =====================================================================
        // SafeZone: Quality Gate
        // =====================================================================
        stage('Quality Gate') {
            steps {
                echo '🛑 Checking Quality Gate...'
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // Stage 3: Backend Tests
        stage('Backend Tests') {
            when { expression { params.SKIP_TESTS == false } }
            steps {
                echo '🧪 Running backend tests...'
                script {
                    dir('user-service') { sh 'mvn test' }
                    dir('product-service') { sh 'mvn test' }
                }
            }
        }

        // Stage 3b: Frontend Tests
        stage('Frontend Tests') {
            when { expression { params.SKIP_TESTS == false } }
            steps {
                echo '🎨 Running frontend tests...'
                script {
                    dir('buy-01-ui') {
                        sh 'npm ci --legacy-peer-deps'
                        sh 'npm run test -- --watch=false --browsers=ChromeHeadlessCI --code-coverage'
                    }
                }
            }
        }

        // Stage 4: Build & Push Docker (Run for Staging/Prod)
        stage('Build & Push Images') {
            when { expression { params.DEPLOY_ENV == 'production' || params.DEPLOY_ENV == 'staging' } }
            steps {
                echo "🚀 Building Docker images with tag: ${env.IMAGE_TAG}..."
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                        sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                    }

                    def services = ['user-service', 'product-service', 'media-service', 'api-gateway', 'service-registry']
                    
                    services.each { service ->
                        sh "docker build -t ${env.DOCKER_USER}/buy-01-${service}:${env.IMAGE_TAG} ./${service}"
                        sh "docker push ${env.DOCKER_USER}/buy-01-${service}:${env.IMAGE_TAG}"
                        // Also push 'latest'
                        sh "docker tag ${env.DOCKER_USER}/buy-01-${service}:${env.IMAGE_TAG} ${env.DOCKER_USER}/buy-01-${service}:latest"
                        sh "docker push ${env.DOCKER_USER}/buy-01-${service}:latest"
                    }
                }
            }
        }

        // Stage 5: Deploy & Rollback Logic
        stage('Deploy Services') {
            when { expression { params.DEPLOY_ENV == 'production' } }
            steps {
                echo "🚢 Deploying version ${env.IMAGE_TAG}..."
                script {
                    // This script handles: Pull, Up, Wait for Health, Smoke Test
                    sh '''
                        set -euo pipefail
                        echo "Using IMAGE_TAG=${IMAGE_TAG}"

                        # 1. Pull new images
                        echo "Pulling images..."
                        docker-compose pull || true

                        # 2. Deploy
                        echo "Starting services with IMAGE_TAG=${IMAGE_TAG}"
                        IMAGE_TAG=${IMAGE_TAG} docker-compose up -d --remove-orphans

                        # 3. Wait for containers to be healthy
                        timeout=90
                        interval=5
                        elapsed=0
                        all_running=0
                        while [ $elapsed -lt $timeout ]; do
                            running_count=$(docker-compose ps --services --filter "status=running" | wc -l)
                            total_count=$(docker-compose ps --services | wc -l)
                            if [ "$running_count" -eq "$total_count" ] && [ "$total_count" -ne "0" ]; then
                                all_running=1
                                break
                            fi
                            sleep $interval
                            elapsed=$((elapsed+interval))
                        done

                        if [ $all_running -ne 1 ]; then
                            echo "ERROR: Not all services reached running state within ${timeout}s"
                            exit 2
                        fi

                        # 4. Smoke Test (Check API Gateway Health)
                        echo "Running smoke tests against API gateway..."
                        smoke_ok=0
                        for i in 1 2 3; do
                            # Checking actuator health endpoint (common in Spring Boot)
                            if curl -sSf http://localhost:8080/actuator/health >/dev/null 2>&1; then
                                smoke_ok=1
                                break
                            fi
                            sleep 3
                        done

                        if [ $smoke_ok -ne 1 ]; then
                            echo "ERROR: Smoke tests failed"
                            exit 3
                        fi

                        echo "Deployment steps completed successfully for ${IMAGE_TAG}"
                    '''
                }
            }
            post {
                failure {
                    echo "⚠️ Deployment failed — running rollback to ${env.PREV_IMAGE_TAG}..."
                    script {
                        // Rollback Logic: Revert to PREV_IMAGE_TAG
                        sh '''
                            set -euo pipefail
                            echo "Rolling back to ${PREV_IMAGE_TAG}"
                            IMAGE_TAG=${PREV_IMAGE_TAG} docker-compose up -d --remove-orphans

                            # Verify Rollback Health
                            timeout=90
                            interval=5
                            elapsed=0
                            rolled_ok=0
                            while [ $elapsed -lt $timeout ]; do
                                if curl -sSf http://localhost:8080/actuator/health >/dev/null 2>&1; then
                                    rolled_ok=1
                                    break
                                fi
                                sleep $interval
                                elapsed=$((elapsed+interval))
                            done

                            if [ $rolled_ok -ne 1 ]; then
                                echo "CRITICAL: Rollback failed to restore service health."
                                docker-compose logs --tail=50
                                exit 1
                            fi

                            echo "✅ Rollback successful. Restored to ${PREV_IMAGE_TAG}."
                        '''
                    }
                }
                success {
                    echo "✅ Deployment successful and verified!"
                }
            }
        }
    }
    
    // Send Status to GitHub (Required for SafeZone Audit)
    post {
        always {
             step([$class: 'GitHubCommitStatusSetter', 
                  contextSource: [$class: 'ManuallyEnteredCommitContextSource', context: 'ci/jenkins/safezone'], 
                  statusResultSource: [$class: 'ConditionalStatusResultSource', results: [[$class: 'AnyBuildResult', message: 'Build finished', state: 'SUCCESS']]]
            ])
        }
    }
}
