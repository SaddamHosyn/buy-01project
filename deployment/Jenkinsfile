// =============================================================================
// Buy-01 E-Commerce Platform - SafeZone CI/CD Pipeline
// =============================================================================
pipeline {
    agent any

    parameters {
        choice(name: 'DEPLOY_ENV', choices: ['local', 'staging', 'production'], description: 'Select deployment environment')
        booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: 'Skip tests (use with caution)')
    }

    environment {
        DOCKER_USER          = credentials('docker-hub-username')
        REGISTRY_CREDENTIALS = 'docker-hub-credentials'
    }

    triggers {
        githubPush()
    }

    stages {
        // Stage 1: Checkout
        stage('Checkout') {
            steps {
                echo "📦 Checking out code..."
                checkout scm
            }
        }

        // Stage 2: Secret Scanning
        stage('Secret Scanning') {
            steps {
                echo '🔍 Scanning for accidentally committed secrets...'
                script {
                    // Simple grep check for API keys
                    def result = sh(script: "grep -r -E -i 'api.?key.*=.*[A-Za-z0-9]{30,}' --include='*.java' --exclude-dir=target . || true", returnStdout: true).trim()
                    if (result) {
                        error('❌ Secrets detected in code! Pipeline blocked.')
                    } else {
                        echo '✅ No secrets detected.'
                    }
                }
            }
        }

        // =====================================================================
        // SafeZone Stage: Code Quality Analysis
        // =====================================================================
        stage('SonarQube Analysis') {
            steps {
                echo '📊 Running SonarQube Analysis...'
                // 'sonar-server' must match the name in Jenkins System Config
                withSonarQubeEnv('sonar-server') { 
                    // Overriding sonar.host.url to point to the local docker container
                    sh """
                        mvn clean verify sonar:sonar \\
                        -Dsonar.projectKey=safezone-backend \\
                        -Dsonar.host.url=http://sonarqube:9000 \\
                        -Dmaven.test.failure.ignore=true
                    """
                }
            }
        }

        // =====================================================================
        // SafeZone Stage: Quality Gate
        // =====================================================================
        stage('Quality Gate') {
            steps {
                echo '🛑 Checking Quality Gate...'
                timeout(time: 5, unit: 'MINUTES') {
                    // Fails pipeline if SonarQube reports "Failed" status
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // Stage 3: Backend Tests (Runs only if Quality Gate passed)
        stage('Backend Tests') {
            when { expression { params.SKIP_TESTS == false } }
            steps {
                echo '🧪 Running backend tests...'
                script {
                    dir('user-service') { sh 'mvn test' }
                    dir('product-service') { sh 'mvn test' }
                    // Add other services as needed
                }
            }
        }

        // Stage 4: Build & Push Docker (Only runs if Quality Gate & Tests pass)
        stage('Build & Push Images') {
            when { expression { params.DEPLOY_ENV == 'production' } }
            steps {
                echo '🚀 Building and Pushing Docker images...'
                // Your docker build steps here
            }
        }
    }
}
// ============================================================================