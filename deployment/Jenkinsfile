// =============================================================================
// Buy-01 E-Commerce Platform - SafeZone + Deployment CI/CD Pipeline
// =============================================================================
pipeline {
    agent any

    parameters {
        choice(name: 'DEPLOY_ENV', choices: ['local', 'staging', 'production'], description: 'Select deployment environment')
        booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: 'Skip tests (use with caution)')
    }

    environment {
        DOCKER_USER          = credentials('docker-hub-username')
        REGISTRY_CREDENTIALS = 'docker-hub-credentials'
        // Tag images with build number for easy rollback
        IMAGE_TAG            = "${env.BUILD_NUMBER}"
        PREV_IMAGE_TAG       = "${env.BUILD_NUMBER.toInteger() - 1}"
    }

    triggers {
        githubPush()
    }

    stages {
        // Stage 1: Checkout
        stage('Checkout') {
            steps {
                echo "📦 Checking out code..."
                checkout scm
            }
        }

        // Stage 2: Secret Scanning
        stage('Secret Scanning') {
            steps {
                echo '🔍 Scanning for secrets...'
                script {
                    def result = sh(script: "grep -r -E -i 'api.?key.*=.*[A-Za-z0-9]{30,}' --include='*.java' --exclude-dir=target . || true", returnStdout: true).trim()
                    if (result) {
                        error('❌ Secrets detected! Pipeline blocked.')
                    }
                }
            }
        }

        // =====================================================================
        // SafeZone: SonarQube Analysis
        // =====================================================================
        stage('SonarQube Analysis') {
            steps {
                echo '📊 Running SonarQube Analysis...'
                withSonarQubeEnv('sonar-server') { 
                    sh """
                        mvn clean verify sonar:sonar \\
                        -Dsonar.projectKey=safezone-backend \\
                        -Dsonar.host.url=http://sonarqube:9000 \\
                        -Dmaven.test.failure.ignore=true
                    """
                }
            }
        }

        // =====================================================================
        // SafeZone: Quality Gate
        // =====================================================================
        stage('Quality Gate') {
            steps {
                echo '🛑 Checking Quality Gate...'
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // Stage 3: Backend Tests
        stage('Backend Tests') {
            when { expression { params.SKIP_TESTS == false } }
            steps {
                echo '🧪 Running backend tests...'
                script {
                    dir('user-service') { sh 'mvn test' }
                    dir('product-service') { sh 'mvn test' }
                }
            }
        }

        // Stage 4: Build & Push Docker (Enhanced)
        stage('Build & Push Images') {
            // Run on production OR staging (or if manually triggered)
            when { expression { params.DEPLOY_ENV == 'production' || params.DEPLOY_ENV == 'staging' } }
            steps {
                echo "🚀 Building Docker images with tag: ${env.IMAGE_TAG}..."
                script {
                    // Log in to Docker Hub
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                        sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                    }

                    def services = ['user-service', 'product-service', 'media-service', 'api-gateway', 'service-registry']
                    
                    services.each { service ->
                        sh "docker build -t ${env.DOCKER_USER}/buy-01-${service}:${env.IMAGE_TAG} ./${service}"
                        sh "docker push ${env.DOCKER_USER}/buy-01-${service}:${env.IMAGE_TAG}"
                        // Also push 'latest' for convenience
                        sh "docker tag ${env.DOCKER_USER}/buy-01-${service}:${env.IMAGE_TAG} ${env.DOCKER_USER}/buy-01-${service}:latest"
                        sh "docker push ${env.DOCKER_USER}/buy-01-${service}:latest"
                    }
                }
            }
        }

        // Stage 5: Deploy & Rollback Logic (New)
        stage('Deploy Services') {
            when { expression { params.DEPLOY_ENV == 'production' } }
            steps {
                echo "🚢 Deploying version ${env.IMAGE_TAG}..."
                script {
                    // Update docker-compose to use the new tag
                    sh "export IMAGE_TAG=${env.IMAGE_TAG} && docker-compose up -d"
                    
                    // Simple health check (wait 10s then check if containers are running)
                    sleep 10
                    def running = sh(script: "docker-compose ps | grep Up || true", returnStdout: true).trim()
                    if (!running) {
                        error("Deployment failed: No containers running!")
                    }
                }
            }
            post {
                failure {
                    echo "⚠️ Deployment failed! Initiating Rollback to version ${env.PREV_IMAGE_TAG}..."
                    script {
                        // Rollback Logic: Revert to previous tag
                        sh "export IMAGE_TAG=${env.PREV_IMAGE_TAG} && docker-compose up -d"
                        echo "✅ Rollback complete. Restored version ${env.PREV_IMAGE_TAG}."
                    }
                }
                success {
                    echo "✅ Deployment successful!"
                }
            }
        }
    }
    
    // Send Status to GitHub (Required for SafeZone Audit)
    post {
        always {
             step([$class: 'GitHubCommitStatusSetter', 
                  contextSource: [$class: 'ManuallyEnteredCommitContextSource', context: 'ci/jenkins/safezone'], 
                  statusResultSource: [$class: 'ConditionalStatusResultSource', results: [[$class: 'AnyBuildResult', message: 'Build finished', state: 'SUCCESS']]]
            ])
        }
    }
}
// =============================================================================